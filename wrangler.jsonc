{
  "name": "redcoconut-tools",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "tools.ibukuntaiwo.com/*",
      "zone_name": "ibukuntaiwo.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
